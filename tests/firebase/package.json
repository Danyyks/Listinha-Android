{
  "name": "listinha-testes-firebase",
  "private": true,
  "description": "Testes das regras do Firestore (somente Emulator Suite, projeto demo-listinha)",
  "scripts": {
    "test:rules": "vitest run",
    "emuladores": "firebase emulators:start --project demo-listinha --only auth,firestore",
    "test:rules:exec": "firebase emulators:exec --project demo-listinha --only firestore \"vitest run\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.2.0",
    "vitest": "^3.2.0"
  }
}
