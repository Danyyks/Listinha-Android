<!--
  ic_launcher_foreground.xml  ===  a FRENTE do ícone ("A mordida").
  A notinha picotada com uma mordida no canto: a lista deu tanta vontade
  que alguém mordeu. Os <group> mantêm o desenho dentro da zona segura
  (círculo de 66dp) do ícone adaptativo. Também é usada na abertura do app.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.925" android:scaleY="0.925">
        <group android:pivotX="54" android:pivotY="54" android:rotation="-6">

            <!-- O papel, com a mordida em cima e o picote embaixo -->
            <path
                android:fillColor="#FFFDF6"
                android:strokeColor="#FFFDF6"
                android:strokeWidth="1.3"
                android:strokeLineJoin="round"
                android:pathData="M36,25.5H51A7.4,7.4 0 0 0 60.5,34.5A7.4,7.4 0 0 0 67.5,41.5A7.4,7.4 0 0 0 76.5,50V75L72,80.5L67.5,75L63,80.5L58.5,75L54,80.5L49.5,75L45,80.5L40.5,75L36,80.5L31.5,75V30A4.5,4.5 0 0 1 36,25.5Z" />

            <!-- As três linhas da lista, na tinta uva -->
            <path android:strokeColor="#3A1670" android:strokeWidth="6" android:strokeLineCap="round" android:pathData="M39.5,39H47" />
            <path android:strokeColor="#3A1670" android:strokeWidth="6" android:strokeLineCap="round" android:pathData="M39.5,53.5H62" />
            <path android:strokeColor="#3A1670" android:strokeWidth="6" android:strokeLineCap="round" android:pathData="M39.5,67.5H68" />

            <!-- Os farelos da mordida -->
            <path android:fillColor="#FFC4E4" android:pathData="M67.3,31.5a2.7,2.7 0 1 0 5.4,0a2.7,2.7 0 1 0 -5.4,0Z" />
            <path android:fillColor="#FFC4E4" android:pathData="M75.5,38a1.9,1.9 0 1 0 3.8,0a1.9,1.9 0 1 0 -3.8,0Z" />
        </group>
    </group>
</vector>
